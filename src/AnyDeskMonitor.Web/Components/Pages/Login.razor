@page "/login"
@using AnyDeskMonitor.Shared.DTOs
@using AnyDeskMonitor.Web.Services
@inject WebApiClient ApiClient
@inject NavigationManager Navigation

<div style="max-width: 440px; margin: 5rem auto; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); padding: 2.5rem; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 20px 40px rgba(0,0,0,0.5); font-family: system-ui, -apple-system, sans-serif;">
    <div style="text-align: center; margin-bottom: 2rem;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); border-radius: 16px; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35);">
            <span style="font-size: 2rem;">🛡️</span>
        </div>
        <h2 style="margin: 0 0 0.4rem 0; color: #f8fafc; font-size: 1.65rem; font-weight: 800; tracking: -0.02em;">AnyDesk Monitor</h2>
        <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); padding: 0.3rem 0.75rem; border-radius: 9999px; margin-bottom: 0.5rem;">
            <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
            <span style="font-size: 0.8rem; font-weight: 600; color: #60a5fa;">anyrotina.calculorotina.com</span>
        </div>
        <p style="color: #94a3b8; font-size: 0.9rem; margin: 0.5rem 0 0 0;">Painel Administrativo de Agentes Locais</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 0.85rem 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚠️</span>
            <span>@_errorMessage</span>
        </div>
    }

    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
            <label style="display: block; font-weight: 600; font-size: 0.875rem; color: #cbd5e1; margin-bottom: 0.5rem;">Utilizador / E-mail</label>
            <input class="search-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 10px; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); color: #f8fafc; font-size: 0.95rem; outline: none; transition: all 0.2s;" 
                   placeholder="admin@anydesk.com" @bind="_username" />
        </div>
        <div>
            <label style="display: block; font-weight: 600; font-size: 0.875rem; color: #cbd5e1; margin-bottom: 0.5rem;">Palavra-passe</label>
            <input type="password" class="search-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 10px; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); color: #f8fafc; font-size: 0.95rem; outline: none; transition: all 0.2s;" 
                   placeholder="••••••••" @bind="_password" />
        </div>
        <button class="btn-action" style="padding: 0.85rem; font-size: 1rem; font-weight: 700; border-radius: 10px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border: none; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4); margin-top: 0.5rem;" 
                @onclick="HandleLoginAsync">
            🔓 Iniciar Sessão no Painel
        </button>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string? _errorMessage;

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Por favor, preencha o utilizador e a palavra-passe.";
            return;
        }

        var result = await ApiClient.LoginAsync(new LoginDto { Username = _username.Trim(), Password = _password });
        if (result != null)
        {
            Navigation.NavigateTo("");
        }
        else
        {
            _errorMessage = "Utilizador ou palavra-passe incorretos.";
        }
    }
}
