@page "/computers/{Id:guid}"
@using AnyDeskMonitor.Shared.DTOs
@using AnyDeskMonitor.Web.Services
@inject WebApiClient ApiClient
@inject NavigationManager Navigation

@if (_computer == null)
{
    <p>Carregando detalhes do computador...</p>
}
else
{
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
            <h2>@_computer.Name</h2>
            <p style="color: var(--text-secondary);">@_computer.MachineName • IP: @_computer.IPAddress</p>
        </div>
        <div>
            @if (_computer.Status == "ONLINE")
            {
                <span class="status-pill status-online" style="font-size: 1rem;">🟢 ONLINE</span>
            }
            else if (_computer.Status == "OFFLINE")
            {
                <span class="status-pill status-offline" style="font-size: 1rem;">🔴 OFFLINE</span>
            }
            else
            {
                <span class="status-pill status-unknown" style="font-size: 1rem;">🟡 UNKNOWN</span>
            }
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div class="stat-card">
            <h3>Informações Gerais</h3>
            <hr style="border-color: var(--border-color); margin: 0.75rem 0;" />
            <p><strong>ID AnyDesk:</strong> @(_computer.AnyDeskId ?? "Indisponível")</p>
            <p><strong>Sistema Operacional:</strong> @_computer.OperatingSystem (@_computer.OperatingSystemVersion)</p>
            <p><strong>Endereço IP:</strong> @_computer.IPAddress</p>
            <p><strong>Endereço MAC:</strong> @(_computer.MacAddress ?? "N/A")</p>
            <p><strong>Último Heartbeat:</strong> @(_computer.LastHeartbeat.HasValue ? _computer.LastHeartbeat.Value.ToLocalTime().ToString("g") : "Nunca")</p>
            <p><strong>Primeiro Acesso:</strong> @_computer.FirstSeen.ToLocalTime().ToString("g")</p>
        </div>

        <div class="stat-card">
            <h3>Adicionar ID AnyDesk Remoto</h3>
            <hr style="border-color: var(--border-color); margin: 0.75rem 0;" />
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <input class="search-input" placeholder="ID AnyDesk Remoto (ex: 987654321)" @bind="_newRemoteId" />
                <input class="search-input" placeholder="Alias (ex: Servidor Central)" @bind="_newAlias" />
                <input class="search-input" placeholder="Localização (opcional, ex: Lisboa, Portugal)" @bind="_newLocation" />
                <input class="search-input" placeholder="Descrição/Observação" @bind="_newDescription" />
                <button class="btn-action" @onclick="AddRemoteIdAsync">Adicionar ID Remoto</button>
            </div>
        </div>
    </div>

    <div class="card-table" style="margin-bottom: 2rem;">
        <div class="table-toolbar">
            <h3>IDs Remotos Associados</h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID AnyDesk</th>
                    <th>Alias</th>
                    <th>Localização</th>
                    <th>Descrição</th>
                    <th>Autorizado</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (_remoteIds == null || !_remoteIds.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 1.5rem;">
                            Nenhum ID AnyDesk remoto registado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in _remoteIds)
                    {
                        <tr>
                            <td><code>@r.AnyDeskId</code></td>
                            <td>@r.Alias</td>
                            <td>
                                <div style="display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(255, 255, 255, 0.05); padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.08);">
                                    <span style="font-size: 1.1rem;" title="@r.CountryCode">@(string.IsNullOrWhiteSpace(r.CountryFlag) ? "🌐" : r.CountryFlag)</span>
                                    <span style="font-size: 0.85rem; font-weight: 500;">@(string.IsNullOrWhiteSpace(r.Location) ? "Desconhecida" : r.Location)</span>
                                </div>
                            </td>
                            <td>@r.Description</td>
                            <td>
                                <button type="button" @onclick="() => ToggleAuthorizationAsync(r)" title="Clique para alterar autorização (Sim/Não)"
                                        style="border: none; outline: none; cursor: pointer; padding: 0.35rem 0.85rem; border-radius: 9999px; font-weight: 700; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.4rem; transition: all 0.2s ease; @(r.IsAuthorized ? "background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4);" : "background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4);")">
                                    @if (r.IsAuthorized)
                                    {
                                        <span>🟢 Sim</span>
                                    }
                                    else
                                    {
                                        <span>🔴 Não</span>
                                    }
                                </button>
                            </td>
                            <td>
                                <button class="btn-action btn-action-danger" @onclick="() => DeleteRemoteIdAsync(r.Id)">Remover</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-table">
        <div class="table-toolbar">
            <h3>Histórico de Eventos</h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Data/Hora</th>
                    <th>Tipo</th>
                    <th>Mensagem</th>
                    <th>Utilizador</th>
                </tr>
            </thead>
            <tbody>
                @if (_events == null || !_events.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-secondary); padding: 1.5rem;">
                            Nenhum evento registado para este computador.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var e in _events)
                    {
                        <tr>
                            <td>@e.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><strong>@e.Type</strong></td>
                            <td>@e.Message</td>
                            <td>@(e.User ?? "Sistema")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ComputerDto? _computer;
    private List<RemoteAnyDeskIdDto> _remoteIds = new();
    private List<EventDto> _events = new();

    private string _newRemoteId = "";
    private string _newAlias = "";
    private string _newLocation = "";
    private string _newDescription = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _computer = await ApiClient.GetComputerByIdAsync(Id);
        _remoteIds = await ApiClient.GetRemoteIdsByComputerIdAsync(Id);
        _events = await ApiClient.GetEventsByComputerIdAsync(Id);
    }

    private async Task ToggleAuthorizationAsync(RemoteAnyDeskIdDto r)
    {
        r.IsAuthorized = !r.IsAuthorized;
        await ApiClient.UpdateRemoteIdAsync(r.Id, r);
        await LoadDataAsync();
    }

    private async Task AddRemoteIdAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRemoteId)) return;

        var dto = new CreateRemoteAnyDeskIdDto
        {
            ComputerId = Id,
            AnyDeskId = _newRemoteId.Trim(),
            Alias = _newAlias.Trim(),
            Location = _newLocation.Trim(),
            Description = _newDescription.Trim()
        };

        await ApiClient.CreateRemoteIdAsync(dto);
        _newRemoteId = "";
        _newAlias = "";
        _newLocation = "";
        _newDescription = "";
        await LoadDataAsync();
    }

    private async Task DeleteRemoteIdAsync(Guid id)
    {
        await ApiClient.DeleteRemoteIdAsync(id);
        await LoadDataAsync();
    }
}
