@page "/settings"
@inject IConfiguration Config

<h2>Configurações do Sistema</h2>
<p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Parâmetros globais do servidor AnyDeskMonitor e regras de timeout de agentes.</p>

<div class="stat-card" style="max-width: 600px;">
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Intervalo Padrão de Heartbeat (segundos)</label>
            <input class="search-input" style="width: 100%;" value="30" readonly />
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Tempo Limite para Status OFFLINE (segundos)</label>
            <input class="search-input" style="width: 100%;" value="60" readonly />
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Integração AnyDesk</label>
            <input class="search-input" style="width: 100%;" value="Provedor Legítimo Local (LocalAgentAnyDeskProvider)" readonly />
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Versão do Sistema / Agente</label>
            <input class="search-input" style="width: 100%; color: #60a5fa; font-weight: bold;" value="v1.1.2" readonly />
        </div>
    </div>
</div>
